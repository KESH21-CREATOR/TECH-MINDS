{
  "name": "credentialchain-root",
  "version": "1.0.0",
  "description": "CredentialChain - Instant Transcript & Migration Verification System",
  "scripts": {
    "node": "hardhat node",
    "compile": "hardhat compile",
    "deploy": "node scripts/deploy.js",
    "generate-pdf": "node scripts/generate-demo-pdf.js",
    "test:contract": "hardhat test",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ..",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run dev",
    "dev": "concurrently -n \"HARDHAT,BACKEND,FRONTEND\" -c \"yellow,blue,green\" \"npx hardhat node\" \"node scripts/wait-and-deploy.js && cd backend && npm start\" \"cd frontend && npm run dev\""
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "smart-contracts",
    "verification",
    "sha256",
    "hardhat"
  ],
  "author": "CredentialChain Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "hardhat": "^2.22.18",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.17",
    "typechain": "^8.3.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "isomorphic-git": "^1.41.7",
    "pdf-lib": "^1.17.1"
  }
}
